# Исключение виртуального окружения
.venv/

# Исключение файлов и папок IDE
.idea/
*.iml

# Исключение кешей и временных файлов
__pycache__/
*.pyc
*.pyo
*.log

# Исключение файлов ОС
.DS_Store
Thumbs.db

# Исключение зависимостей, которые не должны быть в репозитории
*.env
.env.*

# Исключение лишних пакетов/библиотек
*.egg-info/
